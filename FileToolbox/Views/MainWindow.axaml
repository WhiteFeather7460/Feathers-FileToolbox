<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FileToolbox.Views"
        xmlns:vm="clr-namespace:FileToolbox.ViewModels"
        x:Class="FileToolbox.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FileToolbox"
        Width="900" Height="640"
        MinWidth="640" MinHeight="480">

  <views:MainView DataContext="{Binding $parent[Window].DataContext}" />

</Window>
